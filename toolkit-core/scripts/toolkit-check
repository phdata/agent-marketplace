#!/bin/sh
#
# toolkit-check — launcher for toolkit_check.py, and the one check that cannot be
# written in Python: whether a Python 3 exists at all.
#
# Everything this plugin does is Python (stdlib only), which leaves exactly one gap —
# you cannot run a Python script to find out whether Python is installed. This file is
# that gap and nothing else: it resolves an interpreter, and hands over. All logic,
# including the layered checks and the ok/fail/hint contract, lives in toolkit_check.py.
#
# It is also the SessionStart hook's entry point, so it must never block a session: in
# --hook mode a missing Python is reported as an advisory and the exit code stays 0.
#
# Usage: identical to toolkit_check.py — every argument is passed straight through.
#   toolkit-check [--level python|binary|project|datasource|connect] [--datasource NAME]
#                 [--quiet] [--hook] [--list-datasources]
#
# Exit codes: toolkit_check.py's own, plus 15 when no Python 3 could be found.
#
# Skills on Windows, where this shell script does not run, should invoke
# `python toolkit_check.py` (or `py -3 toolkit_check.py`) directly; the hook line printed
# at session start names the interpreter to use.

set -u

# Resolve this script's directory using only builtins: `dirname` is an external
# binary, and a launcher whose job is to survive a half-broken environment should not
# depend on one. `cd` and `pwd` are builtins in every POSIX shell.
case "$0" in
    */*) _dir=${0%/*} ;;
    *)   _dir=. ;;
esac
SCRIPT_DIR=$(CDPATH= cd -- "$_dir" && pwd)
TARGET="$SCRIPT_DIR/toolkit_check.py"

# Mode flags, read without consuming: every argument is forwarded as given.
HOOK=0
QUIET=0
for arg in "$@"; do
    case "$arg" in
        --hook) HOOK=1 ;;
        --quiet) QUIET=1 ;;
    esac
done

# First interpreter that is actually Python 3. `python` is checked because some systems
# ship only that name; `py -3` is the Windows launcher, harmless to try elsewhere.
PYTHON=""
for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 \
        && "$candidate" -c 'import sys; sys.exit(0 if sys.version_info[0] == 3 else 1)' \
            >/dev/null 2>&1; then
        PYTHON="$candidate"
        break
    fi
done
if [ -z "$PYTHON" ] && command -v py >/dev/null 2>&1 \
    && py -3 -c 'import sys; sys.exit(0)' >/dev/null 2>&1; then
    PYTHON="py -3"
fi

if [ -n "$PYTHON" ]; then
    # shellcheck disable=SC2086
    exec $PYTHON "$TARGET" "$@"
fi

# ---------- no Python 3 on this machine ----------

if [ "$HOOK" -eq 1 ]; then
    # Announce the paths anyway: the session is usable, the scripts are not.
    if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
        announce="${CLAUDE_PLUGIN_ROOT%/}/scripts"
    else
        announce="$SCRIPT_DIR"
    fi
    echo "phData toolkit-core scripts (not on PATH -- invoke by absolute path, with python3): ${announce}/toolkit_check.py, ${announce}/toolkit_setup.py"
    echo "python: NOT FOUND -- no python3, python, or py -3 on PATH."
    echo "Every phData plugin script (preflight checks, Informatica corpus and plan readers, the"
    echo "data-contract review queue) is Python 3 stdlib only, so none of them can run until a"
    echo "Python 3.8+ interpreter is installed. The Toolkit CLI itself is unaffected: it is a JVM"
    echo "application, so plain 'toolkit' commands still work. Tell the user that, and point them"
    echo "at https://www.python.org/downloads/ (or 'brew install python' on macOS)."
    exit 0
fi

if [ "$QUIET" -eq 0 ]; then
    echo "fail python: no python3, python, or py -3 found on PATH"
    echo "hint: install Python 3.8 or newer (https://www.python.org/downloads/, or 'brew install python' on macOS) — every phData plugin script needs it"
fi
exit 15

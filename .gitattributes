# Batch files must keep CRLF: cmd.exe mishandles `goto` in LF-only .cmd files, and
# scripts/toolkit-check.cmd is label-driven.
*.cmd text eol=crlf

# Everything else stays LF, including the POSIX sh launcher, which a CRLF checkout would
# break with "bad interpreter".
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.conf text eol=lf
toolkit-core/scripts/toolkit-check text eol=lf
informatica-*/scripts/* text eol=lf
